# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp

# source paper PDFs (large binaries, symlinked into worktrees, not tracked)
/papers

# tooling caches and worktree seeding helper
.mypy_cache/
/.wt/

# python tooling venvs and caches
.venv*/
__pycache__/
*.pyc
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated paper diagrams (large binaries, regenerated by Script-Image-Gen, kept out of git)
/public/papers/

# add-paper run trace / scratch
/add-paper-trace.md

# editors
.vscode/
.idea/
*.swp
*.swo

# os
Thumbs.db
ehthumbs.db

# local env overrides
*.local

# image-generation tooling lives outside the published repo (this is the Next.js app only)
/Script-Image-Gen/
